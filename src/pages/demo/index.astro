---
// Unlisted: not linked from the main site, noindex. For live talks.
import Base from '../../layouts/Base.astro';

// Code samples live here: Astro would read their braces as expressions.
const code0 = `curl https://tylerw.ai/api/v1/chat/completions \\
  -H "Authorization: Bearer $OPENAI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "messages": [
      {"role": "system", "content": "Answer with only a probability from 0 to 1."},
      {"role": "user", "content": "Is this a scam? Your package is held. Pay $1.99 at usps-redelivery.co"}
    ]
  }'`;
const code1 = `from openai import OpenAI

client = OpenAI()  # reads OPENAI_BASE_URL and OPENAI_API_KEY

r = client.chat.completions.create(
    model="MODEL_ID",
    messages=[
        {"role": "system", "content": "Reply with JSON: {\\"scam\\": probability 0-1, \\"why\\": short reason}"},
        {"role": "user", "content": "Your package is held. Pay $1.99 at usps-redelivery.co"},
    ],
    response_format={"type": "json_object"},
)
print(r.choices[0].message.content)`;
const code2 = `import OpenAI from "openai";

const client = new OpenAI(); // reads OPENAI_BASE_URL and OPENAI_API_KEY

const r = await client.chat.completions.create({
  model: "MODEL_ID",
  messages: [
    { role: "system", content: "Reply with JSON: {\\"scam\\": probability 0-1, \\"why\\": short reason}" },
    { role: "user", content: "Your package is held. Pay $1.99 at usps-redelivery.co" },
  ],
  response_format: { type: "json_object" },
});
console.log(r.choices[0].message.content);`;
---

<Base
  title="System 1, live · tylerw.ai"
  description="Fast AI decisions on your own stuff. A live demo from Tyler Warburton."
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="demo" id="demo">
    <!-- ── Header ─────────────────────────────────────────── -->
    <header class="d-head">
      <div class="marks">
        <span class="mark">ISACA Virginia</span>
        <span class="x" aria-hidden="true">×</span>
        <a class="mark mark-site" href="/"><span class="dot" aria-hidden="true"></span>tylerw.ai</a>
      </div>
      <h1 class="d-title">System 1, <span class="live">live</span></h1>
      <p class="d-sub">Fast AI decisions on your own stuff. Nothing you enter is stored beyond tonight.</p>
      <p class="d-stat mono" id="roomStat" aria-live="polite"></p>
    </header>

    <!-- ── Play ───────────────────────────────────────────── -->
    <section class="play" aria-labelledby="playTitle">
      <h2 class="sec-title" id="playTitle">Play</h2>
      <div class="cards">
        <button class="tool-card" data-open="scam">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z" /><path d="M12 8v5M12 16.5v.5" /></svg>
          </span>
          <span class="tc-name">Scam Check</span>
          <span class="tc-line">Paste a sketchy text. Get a verdict.</span>
          <span class="tc-open">Open</span>
        </button>
        <button class="tool-card" data-open="xray">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M9.5 8h5M9.5 11.5h5M9.5 15h3" /></svg>
          </span>
          <span class="tc-name">App Privacy X-ray</span>
          <span class="tc-line">Pick an app. See what its policy really says.</span>
          <span class="tc-open">Open</span>
        </button>
        <button class="tool-card" data-open="jobs">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><path d="M12 12l6-6" /></svg>
          </span>
          <span class="tc-name">Job Radar</span>
          <span class="tc-line">Enter your job. See which tasks AI takes.</span>
          <span class="tc-open">Open</span>
        </button>
        <button class="tool-card" data-open="custom">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 7h10M4 12h7M4 17h10" /><path d="M17 14l2 2 3-4" /></svg>
          </span>
          <span class="tc-name">Make your own check</span>
          <span class="tc-line">Ask your own question of your own text.</span>
          <span class="tc-open">Open</span>
        </button>
      </div>
    </section>

    <!-- ── Build ──────────────────────────────────────────── -->
    <section class="build" aria-labelledby="buildTitle">
      <details id="build">
        <summary>
          <span>
            <span class="sec-title" id="buildTitle">Build</span>
            <span class="b-sub">Get a demo key and use these models in your own tools, tonight.</span>
          </span>
          <span class="chev" aria-hidden="true"></span>
        </summary>

        <div class="b-body">
          <div class="step">
            <h3><span class="n mono">1</span> Your demo token</h3>
            <p class="muted">Works until midnight, up to 2,000 calls. It points at a proxy, never at a real key.</p>
            <div class="token-row">
              <button class="btn-d primary" id="getToken">Get my token</button>
              <code class="token mono" id="tokenOut" hidden></code>
              <button class="btn-d" id="copyToken" hidden>Copy</button>
            </div>
            <pre class="code" data-copy><code id="envBlock">export OPENAI_BASE_URL=https://tylerw.ai/api/v1
export OPENAI_API_KEY=tmx_your_token_here</code></pre>
          </div>

          <div class="step">
            <h3><span class="n mono">2</span> Plug it into your tools</h3>
            <div class="tabs" role="tablist">
              <button role="tab" aria-selected="true" data-tab="t-curl">curl</button>
              <button role="tab" aria-selected="false" data-tab="t-py">Python</button>
              <button role="tab" aria-selected="false" data-tab="t-js">JavaScript</button>
              <button role="tab" aria-selected="false" data-tab="t-app">Apps</button>
              <button role="tab" aria-selected="false" data-tab="t-chat">ChatGPT / Claude</button>
            </div>
            <div class="tabpanel" id="t-curl">
              <p class="muted">One call, 1 judgment. Swap the message for anything.</p>
              <pre class="code" data-copy><code data-tokenize>{code0}</code></pre>
            </div>
            <div class="tabpanel" id="t-py" hidden>
              <p class="muted"><code class="mono">pip install openai</code>, then:</p>
              <pre class="code" data-copy><code data-tokenize>{code1}</code></pre>
            </div>
            <div class="tabpanel" id="t-js" hidden>
              <p class="muted"><code class="mono">npm i openai</code>, then:</p>
              <pre class="code" data-copy><code data-tokenize>{code2}</code></pre>
            </div>
            <div class="tabpanel" id="t-app" hidden>
              <p class="muted">Any app with an "OpenAI-compatible" or "custom provider" setting (Cursor, Continue, Open WebUI, Raycast, the <code class="mono">llm</code> CLI and more) takes these three values:</p>
              <dl class="kv">
                <div><dt>Base URL</dt><dd class="mono">https://tylerw.ai/api/v1</dd></div>
                <div><dt>API key</dt><dd class="mono" data-token-text>tmx_your_token_here</dd></div>
                <div><dt>Model</dt><dd class="mono" data-model-text>MODEL_ID</dd></div>
              </dl>
            </div>
            <div class="tabpanel" id="t-chat" hidden>
              <p class="muted">No install. Paste the starter prompt below into ChatGPT or Claude and build a checker for your own job.</p>
            </div>
          </div>

          <div class="step">
            <h3><span class="n mono">3</span> Starter prompt</h3>
            <p class="muted">Paste into any chat assistant. It will help you design a fast classifier for a task from your own work.</p>
            <pre class="code prompt" data-copy><code id="starterPrompt" data-tokenize>I just saw a "System 1" demo: small, fast AI models used as judgment engines, not chatbots. Instead of writing paragraphs, they answer structured questions with probabilities in well under a second, so you can run thousands of checks cheaply.

There are three question types:
- Yes/No: the probability something is true ("Does this clause share data with advertisers?")
- Pick one: a probability for each option ("What kind of message is this? bank alert / package / fake job / legitimate")
- Score: a 1-5 rating with a probability per level ("How urgent is this?")

I have an OpenAI-compatible endpoint for tonight:
  base URL: https://tylerw.ai/api/v1
  API key:  tmx_your_token_here
  model:    MODEL_ID

Help me build one of these for a real task from my job in security, audit or risk. First ask me what I do and which repetitive judgment I'd most like to speed up. Then:
1. Write 5-10 precise questions for it (mix of the three types).
2. Give me a short Python script that sends one item plus those questions and asks for JSON with probabilities.
3. Show me how to run it over a CSV of items, and how to check it against 20 examples I label myself before trusting it.</code></pre>
            <div class="row-btns">
              <a class="btn-d" id="starterClaude" target="_blank" rel="noopener" href="https://claude.ai/new">Open in Claude</a>
              <a class="btn-d" id="starterGpt" target="_blank" rel="noopener" href="https://chatgpt.com/">Open in ChatGPT</a>
            </div>
          </div>
        </div>
      </details>
    </section>

    <footer class="d-foot">
      <p>Private by design: message text is never stored or logged; the room wall only shows counts. Tokens and totals are wiped tomorrow.</p>
      <p class="links">
        <a href="https://github.com/tylerwarburton/tylerw.ai/tree/main/functions/api" target="_blank" rel="noopener">Run it locally</a>
        <a href="https://whop.com/token-maxers" target="_blank" rel="noopener">Token Maxers</a>
        <a href="/">tylerw.ai</a>
      </p>
    </footer>

    <!-- ── Tool sheet ─────────────────────────────────────── -->
    <div class="scrim" id="scrim" hidden></div>
    <section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" hidden>
      <div class="sheet-bar">
        <button class="back" id="sheetBack" aria-label="Back">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg> Back
        </button>
        <h2 id="sheetTitle">Tool</h2>
        <span></span>
      </div>
      <div class="sheet-body">
        <!-- Scam Check -->
        <div class="tool" data-tool="scam" hidden>
          <label class="lbl" for="scamText">Paste a text, email or DM.</label>
          <textarea
            id="scamText"
            rows="5"
            maxlength="4000"
            placeholder="e.g. FINAL NOTICE: your E-ZPass has an unpaid toll of $4.35. Pay by today to avoid a $50 fee: ezpass-va.info/pay"
          ></textarea>
          <div class="chips">
            <button class="chip" data-example="toll">Unpaid toll</button>
            <button class="chip" data-example="package">Package held</button>
            <button class="chip" data-example="wrong">Wrong number</button>
            <button class="chip" data-example="legit">A real one</button>
          </div>
          <button class="btn-d primary wide" id="scamGo">Check it</button>
          <div class="result" id="scamOut" aria-live="polite"></div>
        </div>

        <!-- App Privacy X-ray -->
        <div class="tool" data-tool="xray" hidden>
          <input class="search" id="appSearch" type="search" placeholder="Search apps" autocomplete="off" />
          <div id="appPicker" class="app-picker"></div>
          <div class="result" id="xrayOut" aria-live="polite"></div>
        </div>

        <!-- Job Radar -->
        <div class="tool" data-tool="jobs" hidden>
          <div class="combo">
            <input
              class="search"
              id="jobSearch"
              type="search"
              placeholder="Your job title, e.g. auditor, SOC analyst"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="jobList"
            />
            <ul class="suggest" id="jobList" role="listbox" hidden></ul>
          </div>
          <div class="chips" id="jobChips"></div>
          <div class="result" id="jobsOut" aria-live="polite"></div>
        </div>

        <!-- Make your own check -->
        <div class="tool" data-tool="custom" hidden>
          <label class="lbl" for="customText">Your text</label>
          <textarea id="customText" rows="4" maxlength="3000" placeholder="An email, a log line, a vendor answer, a ticket, a policy paragraph…"></textarea>
          <div class="chips" id="customPresets">
            <button class="chip" data-preset="vendor">Vendor answer</button>
            <button class="chip" data-preset="log">Log line</button>
            <button class="chip" data-preset="email">Wire request</button>
          </div>
          <div id="customQs" class="cqs"></div>
          <button class="btn-d" id="addQ">+ Add a question</button>
          <button class="btn-d primary wide" id="customGo">Run my checks</button>
          <div class="result" id="customOut" aria-live="polite"></div>
        </div>
      </div>
    </section>

    <div class="toast" id="toast" role="status" hidden></div>
  </div>
</Base>

<script>
  import '../../scripts/demo/app';
</script>

<style is:global>
  .demo {
    --d-bg: #0f1115;
    --d-panel: #161a22;
    --d-panel-2: #1d222c;
    --d-border: #2a303c;
    --d-text: #e6e8ee;
    --d-muted: #8b93a7;
    --d-accent: #5b8def;
    --d-bad: #f87171;
    --d-unsure: #fbbf24;
    --d-good: #4ade80;
    --d-sans: 'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif;
    --d-mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-family: var(--d-sans);
    font-size: 16px;
    color: var(--d-text);
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  .demo .mono {
    font-family: var(--d-mono);
  }
  .demo [hidden] {
    display: none !important;
  }
  .demo .muted {
    color: var(--d-muted);
  }
  .demo button {
    font: inherit;
    color: inherit;
  }

  /* Header */
  .d-head {
    padding: 28px 0 8px;
  }
  .marks {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--d-muted);
  }
  .mark {
    border: 1px solid var(--d-border);
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--d-text);
  }
  .mark-site {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
  .mark-site .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--d-accent);
    box-shadow: 0 0 6px var(--d-accent);
  }
  .d-title {
    margin: 22px 0 0;
    font-size: clamp(40px, 11vw, 68px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .d-title .live {
    color: var(--d-accent);
  }
  .d-sub {
    margin: 12px 0 0;
    color: var(--d-muted);
    font-size: 17px;
    max-width: 36ch;
    line-height: 1.5;
  }
  .d-stat {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--d-muted);
    min-height: 1.2em;
  }
  .sec-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d-accent);
    margin: 0;
  }

  /* Play cards */
  .play {
    margin-top: 28px;
  }
  .cards {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .tool-card {
    display: grid;
    grid-template-columns: 48px 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 14px;
    row-gap: 2px;
    text-align: left;
    background: var(--d-panel);
    border: 1px solid var(--d-border);
    border-radius: 16px;
    padding: 18px;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
    min-height: 44px;
  }
  .tool-card:hover,
  .tool-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--d-accent);
  }
  .tool-card .ic {
    grid-row: 1 / 4;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(91, 141, 239, 0.12);
  }
  .tool-card svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--d-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tc-name {
    font-weight: 600;
    font-size: 18px;
  }
  .tc-line {
    color: var(--d-muted);
    font-size: 14px;
    line-height: 1.45;
  }
  .tc-open {
    margin-top: 8px;
    justify-self: start;
    font-size: 14px;
    font-weight: 600;
    color: var(--d-accent);
  }
  @media (min-width: 1024px) {
    .tool-card {
      grid-template-columns: 1fr;
      row-gap: 8px;
      padding: 22px;
    }
    .tool-card .ic {
      grid-row: auto;
    }
  }

  /* Build */
  .build {
    margin-top: 28px;
  }
  .build details {
    background: var(--d-panel);
    border: 1px solid var(--d-border);
    border-radius: 16px;
  }
  .build summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 18px;
    cursor: pointer;
    min-height: 44px;
  }
  .build summary::-webkit-details-marker {
    display: none;
  }
  .b-sub {
    display: block;
    margin-top: 6px;
    color: var(--d-muted);
    font-size: 15px;
  }
  .chev {
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--d-muted);
    border-bottom: 2px solid var(--d-muted);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex: none;
  }
  details[open] .chev {
    transform: rotate(-135deg);
  }
  .b-body {
    padding: 0 18px 18px;
    display: grid;
    gap: 26px;
  }
  .b-body > *,
  .result > *,
  .cards > * {
    min-width: 0;
  }
  .step h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step .n {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(91, 141, 239, 0.15);
    color: var(--d-accent);
    font-size: 12px;
  }
  .step p {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.5;
  }
  .token-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .token {
    flex: 1 1 220px;
    min-width: 0;
    background: #0a0c10;
    border: 1px solid var(--d-border);
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    word-break: break-all;
  }
  .code {
    position: relative;
    margin: 0;
    background: #0a0c10;
    border: 1px solid var(--d-border);
    border-radius: 10px;
    padding: 14px;
    padding-top: 40px;
    overflow-x: auto;
    font-family: var(--d-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: #cbd3e0;
  }
  .code.prompt {
    white-space: pre-wrap;
    max-height: 280px;
    overflow-y: auto;
  }
  .code .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
  }
  .tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .tabs button {
    flex: none;
    border: 1px solid var(--d-border);
    background: transparent;
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
    min-height: 40px;
  }
  .tabs button[aria-selected='true'] {
    background: rgba(91, 141, 239, 0.15);
    border-color: var(--d-accent);
  }
  .kv {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .kv div {
    display: grid;
    gap: 2px;
  }
  .kv dt {
    font-size: 12px;
    color: var(--d-muted);
  }
  .kv dd {
    margin: 0;
    font-size: 14px;
    word-break: break-all;
  }
  .row-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  /* Buttons & inputs */
  .btn-d {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 6px;
    border: 1px solid var(--d-border);
    background: var(--d-panel-2);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    text-decoration: none;
    color: var(--d-text);
  }
  .btn-d:hover {
    border-color: var(--d-accent);
    text-decoration: none;
  }
  .btn-d.primary {
    background: var(--d-accent);
    border-color: var(--d-accent);
    color: #0a0d13;
  }
  .btn-d.small {
    min-height: 30px;
    padding: 0 10px;
    font-size: 12px;
  }
  .btn-d.wide {
    width: 100%;
    margin-top: 12px;
  }
  .btn-d:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .demo textarea,
  .demo .search,
  .demo select,
  .demo input[type='text'] {
    width: 100%;
    background: #0a0c10;
    border: 1px solid var(--d-border);
    border-radius: 10px;
    color: var(--d-text);
    font: inherit;
    font-size: 16px;
    padding: 12px 14px;
    resize: vertical;
  }
  .demo textarea:focus,
  .demo .search:focus,
  .demo select:focus,
