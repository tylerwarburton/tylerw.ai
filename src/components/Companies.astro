---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section companies" id="companies">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Companies</p>
      <h2 class="section-title">Where I build.</h2>
      <p class="sub">Founder, co-founder, CTO. Before that, software and cybersecurity at Lockheed Martin.</p>
    </div>

    <ol class="list">
      {
        site.companies.map((c) => {
          const Tag = 'href' in c && c.href ? 'a' : 'div';
          return (
            <li class="reveal">
              <Tag
                class="row spot"
                {...('href' in c && c.href ? { href: c.href, target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="mark" aria-hidden="true">
                  {c.name
                    .split(' ')
                    .map((w) => w[0])
                    .join('')
                    .slice(0, 3)}
                </span>
                <span class="main">
                  <span class="name">{c.name}</span>
                  <span class="note">{c.note}</span>
                </span>
                <span class="meta">
                  <span class="role mono">{c.role}</span>
                  <span class="years mono">{c.years}</span>
                </span>
                {'href' in c && c.href && (
                  <span class="ext" aria-hidden="true">
                    <Icon name="arrow-up-right" size={16} />
                  </span>
                )}
              </Tag>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 640px;
  }
  .section-title {
    margin-top: 12px;
  }
  .sub {
    margin-top: 12px;
    color: var(--ag-muted);
  }
  .list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    border: 1px solid var(--ag-border);
    border-radius: var(--ag-radius-lg);
    overflow: hidden;
    background: var(--ag-panel);
  }
  .list li + li {
    border-top: 1px solid var(--ag-border);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr auto 20px;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    color: inherit;
    overflow: hidden;
  }
  a.row:hover {
    text-decoration: none;
    background: var(--ag-panel-2);
  }
  .mark {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--ag-radius-sm);
    background: var(--ag-accent-12);
    border: 1px solid var(--ag-accent-22);
    color: #9fc0ff;
    font-weight: var(--ag-fw-semi);
    font-size: 13px;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .name {
    font-weight: var(--ag-fw-semi);
    color: var(--ag-text-bright);
    font-size: 16px;
  }
  .note {
    color: var(--ag-muted);
    font-size: var(--ag-fs-base);
  }
  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    text-align: right;
  }
  .role {
    font-size: var(--ag-fs-small);
    color: #9fc0ff;
  }
  .years {
    font-size: var(--ag-fs-mini);
    color: var(--ag-muted);
  }
  .ext {
    color: var(--ag-muted);
  }
  a.row:hover .ext {
    color: var(--ag-accent);
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 40px 1fr 16px;
      gap: 12px;
      padding: 16px;
    }
    .mark {
      width: 40px;
      height: 40px;
    }
    .meta {
      grid-column: 2 / 3;
      grid-row: 2;
      flex-direction: row;
      align-items: center;
      gap: 10px;
      text-align: left;
    }
    .ext {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
