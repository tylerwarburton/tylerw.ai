---
import { experience, fromLinkedIn, duration, span, tenure } from '../data/experience';
import Icon from './Icon.astro';
import LinkedIn from './LinkedIn.astro';

const monogram = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 3)
    .toUpperCase();
---

<section class="section companies" id="companies">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Experience</p>
      <h2 class="section-title">Where I build.</h2>
      <p class="sub">
        Founder, co-founder, and fractional CTO roles, built on years of software and cybersecurity work at Lockheed
        Martin.
      </p>
    </div>

    <ol class="exp reveal">
      {
        experience.map((g) => {
          const multi = g.roles.length > 1;
          const total = tenure(g);
          return (
            <li class="co">
              <span class="logo" aria-hidden="true">
                {monogram(g.company)}
              </span>
              <div class="co-body">
                {multi ? (
                  <div class="co-head">
                    {g.href ? (
                      <a class="co-name" href={g.href} target="_blank" rel="noopener">
                        {g.company}
                        <Icon name="arrow-up-right" size={13} />
                      </a>
                    ) : (
                      <span class="co-name">{g.company}</span>
                    )}
                    {total && <span class="meta">{total}</span>}
                  </div>
                ) : null}

                <ol class:list={['roles', { multi }]}>
                  {g.roles.map((r) => {
                    const d = duration(r.start, r.end);
                    return (
                      <li class="role">
                        <span class="title">{r.title}</span>
                        {!multi &&
                          (g.href ? (
                            <a class="org" href={g.href} target="_blank" rel="noopener">
                              {g.company}
                              <Icon name="arrow-up-right" size={12} />
                            </a>
                          ) : (
                            <span class="org">{g.company}</span>
                          ))}
                        {(r.start || d) && (
                          <span class="meta">
                            {span(r)}
                            {d && <> · {d}</>}
                          </span>
                        )}
                        {r.location && <span class="meta">{r.location}</span>}
                        {r.description && (
                          <p class="desc" data-clamp>
                            {r.description}
                          </p>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </div>
            </li>
          );
        })
      }
    </ol>

    <LinkedIn synced={fromLinkedIn} />
  </div>
</section>

<script>
  // LinkedIn-style "…see more" on long descriptions.
  document.querySelectorAll<HTMLElement>('.companies [data-clamp]').forEach((p) => {
    if (p.scrollHeight <= p.clientHeight + 2) return;
    const btn = document.createElement('button');
    btn.className = 'more';
    btn.textContent = '…see more';
    btn.addEventListener('click', () => {
      p.classList.add('open');
      btn.remove();
    });
    p.after(btn);
  });
</script>

<style>
  .head {
    max-width: 640px;
  }
  .section-title {
    margin-top: 12px;
  }
  .sub {
    margin-top: 12px;
    color: var(--ag-muted);
  }
  .exp {
    list-style: none;
    margin: 28px 0 0;
    padding: 4px 24px;
    border: 1px solid var(--ag-border);
    border-radius: var(--ag-radius-lg);
    background: var(--ag-panel);
  }
  .co {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 20px 0;
  }
  .co + .co {
    border-top: 1px solid var(--ag-border);
  }
  .logo {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: var(--ag-radius-sm);
    background: linear-gradient(145deg, var(--ag-accent-22), var(--ag-accent-12));
    border: 1px solid var(--ag-accent-22);
    color: #9fc0ff;
    font-weight: var(--ag-fw-semi);
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .co-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 12px;
  }
  .co-name {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 16px;
    font-weight: var(--ag-fw-semi);
    color: var(--ag-text-bright);
  }
  a.co-name:hover,
  a.org:hover {
    color: var(--ag-accent);
    text-decoration: none;
  }
  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Multiple roles at one company: LinkedIn's connected-dot rail */
  .roles.multi .role {
    position: relative;
    padding-left: 22px;
  }
  .roles.multi .role::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ag-border-2);
    box-shadow: 0 0 0 3px var(--ag-panel);
    z-index: 1;
  }
  .roles.multi .role:first-child::before {
    background: var(--ag-accent);
  }
  .roles.multi .role:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 6.5px;
    top: 16px;
    bottom: -20px;
    width: 1px;
    background: var(--ag-border-2);
  }
  .role {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .title {
    font-size: 15px;
    font-weight: var(--ag-fw-semi);
    color: var(--ag-text-bright);
  }
  .roles:not(.multi) .title {
    font-size: 16px;
  }
  .org {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    align-self: flex-start;
    color: var(--ag-text-2);
    font-size: var(--ag-fs-body);
  }
  .meta {
    color: var(--ag-muted);
    font-size: var(--ag-fs-base);
  }
  .desc {
    margin-top: 6px;
    color: var(--ag-text-3);
    font-size: var(--ag-fs-body);
    line-height: 1.55;
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .desc:global(.open) {
    display: block;
  }
  .companies :global(.more) {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: 2px 0;
    color: var(--ag-muted);
    font: inherit;
    font-size: var(--ag-fs-base);
    cursor: pointer;
  }
  .companies :global(.more:hover) {
    color: var(--ag-accent);
  }
  @media (max-width: 600px) {
    .exp {
      padding: 4px 16px;
    }
    .co {
      grid-template-columns: 40px 1fr;
      gap: 12px;
    }
    .logo {
      width: 40px;
      height: 40px;
      font-size: 12px;
    }
  }
</style>
