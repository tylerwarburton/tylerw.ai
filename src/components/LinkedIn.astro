---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  synced?: boolean;
}
const { synced = false } = Astro.props;
---

<div class="li reveal" id="linkedin">
  <div class="li-card">
    <div class="li-copy">
      <p class="eyebrow">Full history</p>
      <p class="li-text">{synced ? 'Synced from my LinkedIn. Recommendations and posts live there too.' : 'Every role, recommendation, and post lives on LinkedIn.'}</p>
      <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener">
        <Icon name="linkedin" size={16} /> View LinkedIn <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
    <!-- Official LinkedIn profile badge; the script is only fetched when this scrolls near. -->
    <div class="badge-wrap" data-li-badge>
      <div
        class="badge-base LI-profile-badge"
        data-locale="en_US"
        data-size="large"
        data-theme="dark"
        data-type="HORIZONTAL"
        data-vanity={site.linkedinSlug}
        data-version="v1"
      >
      </div>
    </div>
  </div>
</div>

<script>
  const slot = document.querySelector('[data-li-badge]');
  if (slot) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const s = document.createElement('script');
        s.src = 'https://platform.linkedin.com/badges/js/profile.js';
        s.async = true;
        document.body.appendChild(s);
      },
      { rootMargin: '400px' },
    );
    io.observe(slot);
  }
</script>

<style>
  .li {
    margin-top: 12px;
    display: grid;
    gap: 12px;
  }
  .li-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 20px;
    border: 1px solid var(--ag-border);
    border-radius: var(--ag-radius-lg);
    background: var(--ag-panel);
  }
  .li-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .li-text {
    color: var(--ag-text-2);
  }
  .badge-wrap {
    max-width: 100%;
    overflow: hidden;
  }
</style>
