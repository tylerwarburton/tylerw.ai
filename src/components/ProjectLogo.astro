---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  size?: number;
}
const { project: p, size = 40 } = Astro.props;
const b = p.brand;
const initials = p.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<span
  class:list={['plogo', { light: b?.tile === 'light', img: !!b?.logo }]}
  style={`--s:${size}px;${b ? `--brand:${b.color}` : ''}`}
  aria-hidden="true"
>
  {b?.logo ? <img src={b.logo} alt="" width={size} height={size} loading="lazy" decoding="async" /> : initials}
</span>

<style>
  .plogo {
    --brand: var(--ag-accent);
    width: var(--s);
    height: var(--s);
    flex: none;
    display: grid;
    place-items: center;
    border-radius: calc(var(--s) * 0.24);
    overflow: hidden;
    background: color-mix(in srgb, var(--brand) 14%, var(--ag-well));
    border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    color: var(--brand);
    font-weight: var(--ag-fw-semi);
    font-size: calc(var(--s) * 0.34);
    letter-spacing: 0.02em;
  }
  .plogo.img {
    background: var(--ag-well);
  }
  .plogo.light {
    background: #f5f5f5;
  }
  .plogo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
