---
// Unlisted: not linked from the main site, noindex. For live talks.
import Base from '../layouts/Base.astro';
const { tool = '' } = Astro.props;
const titles: Record<string, string> = { scam: 'Scam Check', xray: 'App Privacy X-ray', jobs: 'Job Radar', custom: 'Make your own check' };

---

<Base
  title={`${titles[tool] || 'System 1, live'} · tylerw.ai`}
  description="Fast AI decisions on your own stuff. A live demo from Tyler Warburton."
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class:list={["demo", { "tool-page": !!tool }]} id="demo" data-tool={tool}>
    <!-- ── Header ─────────────────────────────────────────── -->
    <header class="d-head" hidden={!!tool}>
      <div class="usage-strip" aria-label="Live room and session usage" aria-live="polite">
        <div class="usage-group"><span class="usage-label">Room</span><p class="d-stat mono" id="roomStat">Loading…</p></div>
        <div class="usage-group"><span class="usage-label">You</span><p class="d-stat mono" id="personalStat">Loading…</p></div>
      </div>
      <div class="marks">
        <img class="isaca" src="/demo-data/brand/isaca-va-rev.png" alt="ISACA Virginia Chapter" width="162" height="56" />
        <span class="x" aria-hidden="true">×</span>
        <a class="mark mark-site" href="/"><span class="dot" aria-hidden="true"></span>tylerw.ai</a>
        <h1 class="d-title">System 1, <span class="live">live</span></h1>
        <span class="engine-tag">Jev 1.13</span>
      </div>
    </header>

    <!-- ── Play ───────────────────────────────────────────── -->
    <section hidden={!!tool} class="play" aria-labelledby="playTitle">
      <h2 class="sec-title" id="playTitle">Play</h2>
      <div class="cards">
        <a class="tool-card" href="/demo/scam/">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z" /><path d="M12 8v5M12 16.5v.5" /></svg>
          </span>
          <span class="tc-name">Scam Check</span>
          <span class="tc-line">Paste an email or message. Check it live.</span>
          <span class="tc-open">Open</span>
        </a>
        <a class="tool-card" href="/demo/xray/">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M9.5 8h5M9.5 11.5h5M9.5 15h3" /></svg>
          </span>
          <span class="tc-name">App Privacy X-ray</span>
          <span class="tc-line">Pick an app. See what its policy really says.</span>
          <span class="tc-open">Open</span>
        </a>
        <a class="tool-card" href="/demo/jobs/">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><path d="M12 12l6-6" /></svg>
          </span>
          <span class="tc-name">Job Radar</span>
          <span class="tc-line">Enter your responsibilities. Analyze them live.</span>
          <span class="tc-open">Open</span>
        </a>
        <a class="tool-card" href="/demo/custom/">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 7h10M4 12h7M4 17h10" /><path d="M17 14l2 2 3-4" /></svg>
          </span>
          <span class="tc-name">Make your own check</span>
          <span class="tc-line">Ask your own question of your own text.</span>
          <span class="tc-open">Open</span>
        </a>
      </div>
    </section>

    <!-- ── Build ──────────────────────────────────────────── -->
    <section hidden={!!tool} class="build" aria-labelledby="buildTitle">
      <details id="build">
        <summary><span class="sec-title" id="buildTitle">Build</span><span class="chev" aria-hidden="true"></span></summary>
        <div class="b-body build-simple">
          <pre class="code prompt"><code id="starterPrompt" aria-live="polite">Preparing your demo token…</code></pre>
          <button class="btn-d primary" id="copyBuild" disabled>Copy for Codex, Claude, or your AI</button>
          <button class="btn-d" id="retryBuild" hidden>Retry</button>
        </div>
      </details>
    </section>

    <footer class="d-foot" hidden={!!tool}>
      <p>Private by design: message text is never stored or logged; the room wall only shows counts. Demo tokens expire at midnight Eastern.</p>
      <p class="links">
        <a href="https://github.com/tylerwarburton/tylerw.ai/tree/main/functions/api" target="_blank" rel="noopener">Run it locally</a>
        <a href="https://whop.com/token-maxers" target="_blank" rel="noopener">Token Maxers</a>
        <a href="/">tylerw.ai</a>
      </p>
    </footer>

    <!-- ── Tool sheet ─────────────────────────────────────── -->
    
    <main class="tool-workspace" id="sheet" aria-labelledby="sheetTitle" hidden={!tool}>
      <div class="sheet-bar">
        <a class="back" id="sheetBack" href="/demo/" aria-label="Back to all tools">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg> All tools
        </a>
        <h1 id="sheetTitle">{titles[tool]}</h1>
        <span class="engine-tag">{tool === "jobs" ? "LLM extraction → Jev decisions" : "Jev · System One"}</span>
        <div id="runReceipt" aria-live="polite" aria-label="Latest run usage" hidden></div>
      </div>
      <div class="sheet-body">
        <!-- Scam Check -->
        <div class="tool" data-tool="scam" hidden={tool !== 'scam'}>
          <label class="lbl" for="scamText">Paste the email or message you want to check.</label>
          <textarea
            id="scamText"
            rows="8"
            maxlength="4000"
            placeholder="Paste your email or message here…"
          ></textarea>
          <button class="btn-d primary wide" id="scamGo">Run all checks</button>
          <button class="btn-d wide" id="scamNext">Run next check</button>
          <p class="muted">Scam → spam → priority. Stops when a message needs review or is filtered out.</p>
          <div class="result" id="scamOut" aria-live="polite"></div>
        </div>

        <!-- App Privacy X-ray -->
        <div class="tool" data-tool="xray" hidden={tool !== 'xray'}>
          <input class="search" id="appSearch" type="search" placeholder="Search any iPhone app" aria-label="Search apps by name" autocomplete="off" />
          <div id="appPicker" class="app-picker"></div>
          <div class="result" id="xrayOut" aria-live="polite"></div>
        </div>

        <!-- Job Radar -->
        <div class="tool job-radar" data-tool="jobs" hidden={tool !== 'jobs'}>
          <ol class="jr-steps" aria-label="Analysis progress">
            <li data-job-step="context" aria-current="step"><span>01</span>Your context</li>
            <li data-job-step="review"><span>02</span>Review tasks</li>
            <li data-job-step="results"><span>03</span>Your radar</li>
          </ol>
          <section class="jr-input-card" id="jobContext" aria-labelledby="jobProfileLabel">
            <label class="lbl" id="jobProfileLabel" for="jobProfile">Paste your entire LinkedIn profile or résumé here.</label>
            <textarea id="jobProfile" rows="7" maxlength="40000" placeholder="Paste your profile or résumé text…"></textarea>
            <div class="jr-input-meta"><span>Paste the text, not a link</span><span id="jobCharCount">0 / 40,000</span></div>
            <details class="jr-help"><summary>How to copy your LinkedIn profile</summary><p>Open your own profile. On a computer, press Ctrl+A then Ctrl+C (⌘A and ⌘C on Mac). On a phone, copy the text from About and Experience. Paste it above.</p></details>
            <button class="btn-d primary wide jr-primary" id="extractJob">Find my responsibilities <span aria-hidden="true">→</span></button>
            <button class="jr-text-button" id="manualJob">Or write my tasks myself</button>
            <p class="jr-privacy"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="m8 12 3 3 5-6"/></svg>Your pasted profile text is not stored by this site.</p>
            <div id="jobExtractStatus" aria-live="polite"></div>
          </section>
          <section class="jr-input-card" id="jobReview" hidden aria-labelledby="jobReviewTitle">
            <div class="jr-card-heading"><div class="jr-symbol" aria-hidden="true">✓</div><div><h3 id="jobReviewTitle" tabindex="-1">Review your tasks</h3><p>Edit or remove anything that is wrong.</p></div></div>
            <p id="jobTaskSource" class="job-source-note" hidden></p>
            <label class="lbl" for="jobSearch">Your job title</label>
            <input class="search" id="jobSearch" type="text" maxlength="120" placeholder="Your role" autocomplete="off" />
            <div class="jr-label-row"><label class="lbl" for="jobTasks">Your responsibilities</label><span id="jobTaskCount">0 tasks</span></div>
            <textarea id="jobTasks" rows="9" maxlength="12000" placeholder="Write one responsibility per line…"></textarea>
            <p class="jr-input-hint">One task per line · up to 40 tasks</p>
            <button class="btn-d primary wide jr-primary" id="jobsGo">Analyze my tasks <span aria-hidden="true">→</span></button>
            <button class="jr-text-button" id="jobBackContext">← Back to my context</button>
          </section>
          <div class="result" id="jobsOut" aria-live="polite"></div>
        </div>

        <!-- Make your own check -->
        <div class="tool" data-tool="custom" hidden={tool !== 'custom'}>
          <label class="lbl" for="customText">Your text</label>
          <textarea id="customText" rows="4" maxlength="3000" placeholder="An email, a log line, a vendor answer, a ticket, a policy paragraph…"></textarea>
          <div id="customQs" class="cqs"></div>
          <button class="btn-d" id="addQ">+ Add a question</button>
          <button class="btn-d primary wide" id="customGo">Run my checks</button>
          <div class="result" id="customOut" aria-live="polite"></div>
        </div>
      </div>
    </main>

    <div class="toast" id="toast" role="status" hidden></div>
  </div>
</Base>

<script>
  import '../scripts/demo/app';
</script>

<style is:global>
  .demo {
    --d-bg: #0f1115;
    --d-panel: #161a22;
    --d-panel-2: #1d222c;
    --d-border: #2a303c;
    --d-text: #e6e8ee;
    --d-muted: #8b93a7;
    --d-accent: #5b8def;
    --d-bad: #f87171;
    --d-unsure: #fbbf24;
    --d-good: #4ade80;
    --d-sans: 'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif;
    --d-mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-family: var(--d-sans);
    font-size: 16px;
    color: var(--d-text);
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  .demo .mono {
    font-family: var(--d-mono);
  }
  .demo [hidden] {
    display: none !important;
  }
  .demo .muted {
    color: var(--d-muted);
  }
  .demo button {
    font: inherit;
    color: inherit;
  }

  /* Header */
  .d-head {
    padding: 28px 0 8px;
  }
  .marks {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--d-muted);
  }
  .isaca {
    height: 40px;
    width: auto;
  }
  .mark {
    border: 1px solid var(--d-border);
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--d-text);
  }
  .mark-site {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
  .mark-site .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--d-accent);
    box-shadow: 0 0 6px var(--d-accent);
  }
  .d-title {
    margin: 22px 0 0;
    font-size: clamp(40px, 11vw, 68px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .d-title .live {
    color: var(--d-accent);
  }
  .d-sub {
    margin: 12px 0 0;
    color: var(--d-muted);
    font-size: 17px;
    max-width: 36ch;
    line-height: 1.5;
  }
  .d-stat {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--d-muted);
    min-height: 1.2em;
  }
  .sec-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--d-accent);
    margin: 0;
  }

  /* Play cards */
  .play {
    margin-top: 28px;
  }
  .cards {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .tool-card {
    display: grid;
    grid-template-columns: 48px 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 14px;
    row-gap: 2px;
    text-align: left;
    background: var(--d-panel);
    border: 1px solid var(--d-border);
    border-radius: 16px;
    padding: 18px;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
    min-height: 44px;
  }
  .tool-card:hover,
  .tool-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--d-accent);
  }
  .tool-card .ic {
    grid-row: 1 / 4;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(91, 141, 239, 0.12);
  }
  .tool-card svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--d-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tc-name {
    font-weight: 600;
    font-size: 18px;
  }
  .tc-line {
    color: var(--d-muted);
    font-size: 14px;
    line-height: 1.45;
  }
  .tc-open {
    margin-top: 8px;
    justify-self: start;
    font-size: 14px;
    font-weight: 600;
    color: var(--d-accent);
  }
  @media (min-width: 1024px) {
    .tool-card {
      grid-template-columns: 1fr;
      row-gap: 8px;
      padding: 22px;
    }
    .tool-card .ic {
      grid-row: auto;
    }
  }

  /* Build */
  .build {
    margin-top: 28px;
  }
  .build details {
    background: var(--d-panel);
    border: 1px solid var(--d-border);
    border-radius: 16px;
  }
  .build summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 18px;
    cursor: pointer;
    min-height: 44px;
  }
  .build summary::-webkit-details-marker {
    display: none;
  }
  .b-sub {
    display: block;
    margin-top: 6px;
    color: var(--d-muted);
    font-size: 15px;
  }
  .chev {
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--d-muted);
    border-bottom: 2px solid var(--d-muted);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex: none;
  }
  details[open] .chev {
    transform: rotate(-135deg);
  }
  .b-body {
    padding: 0 18px 18px;
    display: grid;
    gap: 26px;
  }
  .b-body > *,
  .result > *,
  .cards > * {
    min-width: 0;
  }
  .step h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step .n {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(91, 141, 239, 0.15);
    color: var(--d-accent);
    font-size: 12px;
  }
  .step p {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.5;
  }
  .token-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .token {
    flex: 1 1 220px;
    min-width: 0;
    background: #0a0c10;
    border: 1px solid var(--d-border);
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    word-break: break-all;
  }
  .code {
    position: relative;
    margin: 0;
    background: #0a0c10;
    border: 1px solid var(--d-border);
    border-radius: 10px;
    padding: 14px;
    padding-top: 40px;
    overflow-x: auto;
    font-family: var(--d-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: #cbd3e0;
  }
  .code.prompt {
    white-space: pre-wrap;
    max-height: 280px;
    overflow-y: auto;
  }
  .code .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
  }
  .tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .tabs button {
    flex: none;
    border: 1px solid var(--d-border);
    background: transparent;
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
    min-height: 40px;
  }
  .tabs button[aria-selected='true'] {
    background: rgba(91, 141, 239, 0.15);
    border-color: var(--d-accent);
  }
  .kv {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .kv div {
    display: grid;
    gap: 2px;
  }
  .kv dt {
    font-size: 12px;
    color: var(--d-muted);
  }
  .kv dd {
    margin: 0;
    font-size: 14px;
    word-break: break-all;
  }
  .row-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  /* Buttons & inputs */
  .btn-d {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 6px;
    border: 1px solid var(--d-border);
    background: var(--d-panel-2);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    text-decoration: none;
    color: var(--d-text);
  }
  .btn-d:hover {
    border-color: var(--d-accent);
    text-decoration: none;
  }
  .btn-d.primary {
    background: var(--d-accent);
    border-color: var(--d-accent);
    color: #0a0d13;
  }
  .btn-d.small {
    min-height: 30px;
    padding: 0 10px;
    font-size: 12px;
  }
  .btn-d.wide {
    width: 100%;
    margin-top: 12px;
  }
  .btn-d:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .demo textarea,
  .demo .search,
  .demo select,
  .demo input[type='text'] {
    width: 100%;
    background: #0a0c10;
    border: 1px solid var(--d-border);
    border-radius: 10px;
    color: var(--d-text);
    font: inherit;
    font-size: 16px;
    padding: 12px 14px;
    resize: vertical;
  }
  .demo textarea:focus,
  .demo .search:focus,
  .demo select:focus,
  .demo input:focus {
    outline: 2px solid var(--d-accent);
    outline-offset: 1px;
  }
  .lbl {
    display: block;
    font-size: 14px;
    color: var(--d-muted);
    margin-bottom: 8px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .chip {
    border: 1px solid var(--d-border);
    background: var(--d-panel-2);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
    min-height: 40px;
  }
  .chip:hover {
    border-color: var(--d-accent);
  }

  /* Dedicated tool pages */
  .tool-page { max-width: 1040px; }
  .tool-workspace { padding: 4px 0 32px; }
  .app-icon { width: 56px; height: 56px; object-fit: cover; border-radius: 13px; }
  .tool-card { color: inherit; text-decoration: none; }
  .back { text-decoration: none; }
  .sheet-bar {
    display: flex;
    gap: 16px;
    align-items: center;
    min-height: 48px;
    padding: 0;
    border-bottom: 1px solid var(--d-border);
    background: transparent;
  }
  .sheet-bar h1 {
    margin: 0;
    font-size: clamp(16px, 2.5vw, 21px);
    line-height: 1.2;
    font-weight: 600;
  }
  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: 0;
    color: var(--d-accent);
    font-size: 16px;
    min-height: 44px;
    padding: 0 8px;
    cursor: pointer;
  }
  .back svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .sheet-body {
    flex: 1;
    padding: 16px 0 32px;
    -webkit-overflow-scrolling: touch;
  }

  /* Results */
  .result:empty {
    display: none;
  }
  .result {
    scroll-margin-top: 12px;
    margin-top: 20px;
    display: grid;
    gap: 14px;
  }
  .verdict {
    border: 1px solid var(--d-border);
    border-left: 6px solid var(--c);
    background: var(--d-panel);
    border-radius: 12px;
    padding: 16px 18px;
  }
  .verdict .word {
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--c);
  }
  .verdict .big {
    font-family: var(--d-mono);
    font-size: 56px;
    font-weight: 600;
    line-height: 1;
    margin-top: 10px;
  }
  .verdict .big small {
    font-size: 18px;
    color: var(--d-muted);
    font-weight: 400;
    margin-left: 6px;
  }
  .gauge {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--d-good), var(--d-unsure) 50%, var(--d-bad));
    position: relative;
    margin-top: 14px;
  }
  .gauge i {
    position: absolute;
    top: -5px;
    width: 4px;
    height: 20px;
    border-radius: 2px;
    background: #fff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    transform: translateX(-50%);
  }
  .panel-d {
    background: var(--d-panel);
    border: 1px solid var(--d-border);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .panel-d h4 {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--d-muted);
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .fact .v {
    font-size: 17px;
    font-weight: 600;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--d-border);
    border-radius: 999px;
    padding: 5px 12px;
    background: var(--d-panel-2);
    cursor: pointer;
    font-size: 15px;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--d-border);
  }
  .dots i.on {
    background: var(--d-unsure);
  }
  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .flag {
    border: 1px solid rgba(248, 113, 113, 0.45);
    color: #fca5a5;
    background: rgba(248, 113, 113, 0.08);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 14px;
  }
  .pbar {
    display: grid;
    grid-template-columns: minmax(90px, 38%) 1fr 48px;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    padding: 4px 0;
  }
  .pbar .l {
    font-family: var(--d-mono);
    color: var(--d-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pbar .b {
    height: 8px;
    border-radius: 999px;
    background: var(--d-panel-2);
    overflow: hidden;
  }
  .pbar .b i {
    display: block;
    height: 100%;
    background: var(--c, var(--d-accent));
    border-radius: inherit;
  }
  .pbar .v {
    font-family: var(--d-mono);
    text-align: right;
  }
  .speed {
    font-family: var(--d-mono);
    font-size: 13px;
    color: var(--d-muted);
  }
  .speed b {
    color: var(--d-good);
    font-weight: 600;
  }
  .deeper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ticker {
    background: var(--d-panel);
    border: 1px dashed var(--d-border);
    border-radius: 12px;
    padding: 18px;
    font-family: var(--d-mono);
    font-size: 22px;
  }
  .ticker small {
    display: block;
    font-size: 13px;
    color: var(--d-muted);
    margin-top: 6px;
    font-family: var(--d-sans);
  }
  .err {
    border-left: 6px solid var(--d-unsure);
    background: var(--d-panel);
    border-radius: 12px;
    padding: 14px 16px;
  }

  /* App picker */
  .app-picker {
    margin-top: 12px;
    display: grid;
    gap: 16px;
  }
  .app-row h5 {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--d-muted);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 8px;
  }
  .tile {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--d-border);
    background: var(--d-panel);
    cursor: pointer;
    font-size: 15px;
    text-align: left;
    min-height: 44px;
  }
  .app-copy { display: grid; gap: 5px; min-width: 0; overflow-wrap: anywhere; }
  .app-copy b { font-weight: 500; line-height: 1.3; }
  .app-copy small { font-size: 12px; line-height: 1.4; }
  .tile:hover {
    border-color: var(--d-accent);
  }
  .tile .mono-g {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 15px;
    color: #0a0d13;
    background: hsl(var(--h) 70% 68%);
  }
  .x-head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .x-head .mono-g {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 20px;
    color: #0a0d13;
    background: hsl(var(--h) 70% 68%);
    flex: none;
  }
  .x-head h3 {
    margin: 0;
    font-size: 22px;
  }
  .x-head p {
    margin: 2px 0 0;
    color: var(--d-muted);
    font-size: 13px;
  }
  .qrow {
    border-top: 1px solid var(--d-border);
  }
  .qrow:first-child {
    border-top: 0;
  }
  .qrow button {
    width: 100%;
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 12px;
    align-items: center;
    text-align: left;
    background: none;
    border: 0;
    padding: 12px 0;
    cursor: pointer;
    min-height: 44px;
  }
  .light {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 8px var(--c);
  }
  .qrow .q {
    font-size: 15px;
    line-height: 1.35;
  }
  .qrow .p {
    font-family: var(--d-mono);
    font-size: 15px;
  }
  .evidence {
    margin: 0 0 12px 26px;
    padding: 10px 12px;
    border-left: 3px solid var(--c);
    background: #0a0c10;
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    line-height: 1.55;
    color: #cbd3e0;
  }
  .evidence a {
    display: inline-block;
    margin-top: 6px;
    font-size: 13px;
  }

  /* Job Radar */
  .combo {
    position: relative;
  }
  .suggest {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    z-index: 5;
    list-style: none;
    margin: 0;
    padding: 4px;
    background: var(--d-panel-2);
    border: 1px solid var(--d-border);
    border-radius: 10px;
    max-height: 300px;
    overflow-y: auto;
  }
  .suggest li {
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 15px;
  }
  .suggest li small {
    display: block;
    color: var(--d-muted);
    font-size: 12px;
  }
  .suggest li[aria-selected='true'],
  .suggest li:hover {
    background: rgba(91, 141, 239, 0.15);
  }
  .split {
    display: flex;
    height: 34px;
    border-radius: 8px;
    overflow: hidden;
    font-size: 12px;
    font-weight: 600;
    color: #0a0d13;
  }
  .split span {
    display: grid;
    place-items: center;
    white-space: nowrap;
    overflow: hidden;
    min-width: 0;
  }
  .b-Automate {
    --c: #f87171;
  }
  .b-Augment {
    --c: #fbbf24;
  }
  .b-Own {
    --c: #4ade80;
  }
  .split span {
    background: var(--c);
  }
  .cols {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .col h4 {
    color: var(--c);
  }
  .task {
    font-size: 14px;
    line-height: 1.45;
    padding: 8px 0;
    border-top: 1px solid var(--d-border);
  }
  .task:first-of-type {
    border-top: 0;
  }
  .task .conf {
    height: 4px;
    border-radius: 999px;
    background: var(--d-panel-2);
    margin-top: 6px;
    overflow: hidden;
  }
  .task .conf i {
    display: block;
    height: 100%;
    background: var(--c);
  }
  .tag-b {
    display: inline-block;
    margin-left: 6px;
    font-size: 11px;
    color: var(--d-unsure);
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-radius: 999px;
    padding: 0 6px;
  }
  .credit {
    font-size: 12px;
    color: var(--d-muted);
  }

  /* Custom checks */
  .cqs {
    display: grid;
    gap: 10px;
    margin: 16px 0 10px;
  }
  .cq {
    background: var(--d-panel);
    border: 1px solid var(--d-border);
    border-radius: 12px;
    padding: 12px;
    display: grid;
    gap: 8px;
  }
  .cq-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  @media (min-width: 560px) {
    .cq-top {
      grid-template-columns: 1fr auto;
    }
  }
  .cq select {
    justify-self: start;
    width: auto;
    font-size: 14px;
    padding: 8px 10px;
  }
  .cq .rm {
    background: none;
    border: 0;
    color: var(--d-muted);
    cursor: pointer;
    font-size: 13px;
    justify-self: end;
  }

  .d-foot {
    margin-top: 36px;
    color: var(--d-muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .d-foot .links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    z-index: 80;
    background: var(--d-panel-2);
    border: 1px solid var(--d-border);
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .tool-card {
      transition: none;
    }
  }

  /* Job Radar: a focused, touch-friendly flow. */
  .demo[data-tool="jobs"] { --d-accent: #71e5d2; max-width: 1080px; }
  .demo[data-tool="jobs"] .sheet-bar { padding: 0; background: transparent; border-bottom: 1px solid #242c36; gap: 8px; }
  .demo[data-tool="jobs"] .sheet-bar h1 { font-size: 18px; letter-spacing: -.02em; }
  .demo[data-tool="jobs"] .back { padding-left: 0; color: #9da9bc; font-size: 14px; }
  .demo[data-tool="jobs"] .sheet-body { padding-top: 16px; }
  .job-radar { --jr-auto: #a49aff; --jr-augment: #70dded; --jr-own: #81e2b1; }
  .jr-intro { margin-bottom: 30px; }
  .jr-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: #9aaabd; text-transform: uppercase; font-size: 11px; letter-spacing: .15em; }
  .jr-live-dot { width: 6px; height: 6px; background: #71e5d2; border-radius: 50%; box-shadow: 0 0 14px #71e5d255; }
  .jr-intro h2 { margin: 16px 0 12px; font-size: clamp(36px, 6vw, 60px); line-height: 1.06; letter-spacing: -.055em; font-weight: 500; }
  .jr-intro h2 span { color: #71e5d2; }
  .jr-intro > p { color: #a1acbc; max-width: 510px; font-size: 16px; line-height: 1.65; margin: 0; }
  .jr-steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); list-style: none; padding: 0; margin: 0 0 26px; gap: 12px; }
  .jr-steps li { border-top: 2px solid #28313e; padding-top: 12px; color: #8692a4; font-size: 13px; display: flex; align-items: center; gap: 10px; }
  .jr-steps li span { font: 11px var(--d-mono); opacity: .8; }
  .jr-steps li[aria-current="step"] { border-color: #71e5d2; color: #d8fff6; }
  .jr-steps li[data-complete="true"] { border-color: #3c796f; color: #a4c0bb; }
  .jr-input-card { max-width: 760px; margin: 0 auto; padding: clamp(20px,4vw,36px); background: linear-gradient(145deg,#19212c,#131922); border: 1px solid #2b3544; border-radius: 24px; box-shadow: 0 20px 70px #0002; }
  .jr-card-heading { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 26px; }
  .jr-symbol { flex-shrink: 0; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px; background: #71e5d212; border: 1px solid #71e5d22a; color: #71e5d2; font-size: 24px; }
  .jr-card-heading h3 { font-size: 23px; letter-spacing: -.035em; margin: 0 0 5px; font-weight: 500; }
  .jr-card-heading p { color: #9ca9bb; font-size: 14px; line-height: 1.5; margin: 0; }
  .job-radar textarea { line-height: 1.65; border-radius: 14px; background: #0c121b; padding: 16px; border-color: #334052; min-height: 180px; }
  .job-radar .search { background: #0c121b; border-color: #334052; min-height: 52px; }
  .job-radar .lbl { color: #d0d9e5; font-size: 13px; }
  .jr-input-meta { display: flex; justify-content: space-between; gap: 12px; color: #8392a7; font-size: 11px; margin-top: 9px; }
  #jobCharCount { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .jr-help { color: #a3b2c5; font-size: 13px; margin: 14px 0 18px; }
  .jr-help summary { cursor: pointer; padding: 8px 0; min-height: 36px; }
  .jr-help p { line-height: 1.6; margin: 4px 0 10px; }
  .demo .jr-primary { min-height: 54px; border-radius: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 18px; box-shadow: 0 6px 24px #71e5d210; }
  .jr-primary span { font-size: 21px; }
  .demo .jr-text-button { display: block; margin: 12px auto 0; border: 0; background: transparent; color: #acbbcf; min-height: 44px; padding: 8px 14px; cursor: pointer; font-size: 13px; }
  .jr-text-button:hover { color: #71e5d2; }
  .jr-privacy { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 11px; color: #8e9caf; margin: 20px 0 0; line-height: 1.5; }
  .jr-privacy svg { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .jr-label-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 22px; }
  .jr-label-row span,.jr-input-hint { color: #8e9caf; font-size: 12px; }
  .jr-input-hint { margin: 9px 0 18px; }
  .job-radar #jobsOut { margin-top: 0; gap: 22px; }
  .jr-summary { display: grid; grid-template-columns: 240px minmax(0,1fr); align-items: center; gap: 32px; padding: 32px; border: 1px solid #314052; border-radius: 24px; background: radial-gradient(ellipse at 10% 20%,#70dded0c,transparent 65%),#151d28; }
  .jr-ring { width: 240px; max-width: 100%; height: auto; }
  .jr-ring .jr-ring-number { fill: #eef5ff; font: 500 48px var(--d-sans); letter-spacing: -2px; }
  .jr-ring .jr-ring-label { fill: #96a8bd; font: 10px var(--d-mono); letter-spacing: 2px; }
  .jr-result-kicker { color: #71e5d2; text-transform: uppercase; letter-spacing: .14em; font-size: 10px; }
  .jr-summary h3 { margin: 10px 0; font-size: clamp(24px,4vw,36px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; overflow-wrap: anywhere; }
  .jr-summary p { color: #a7b5c7; font-size: 15px; line-height: 1.65; margin: 0 0 14px; }
  .jr-run-meta { display: flex; flex-wrap: wrap; gap: 8px; color: #98afc4; font: 11px var(--d-mono); }
  .jr-run-meta span { background: #0c141e; border: 1px solid #293747; border-radius: 6px; padding: 6px 9px; }
  .jr-stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
  .demo .jr-stat { text-align: left; padding: 18px; border-radius: 16px; background: #151d28; border: 1px solid #2c3746; min-height: 128px; cursor: pointer; color: #edf3ff; }
  .jr-stat[aria-pressed="true"] { border-color: var(--jr-color); background: color-mix(in srgb,var(--jr-color) 8%,#151d28); }
  .jr-stat-label { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--jr-color); }
  .jr-stat-label i { width: 7px; height: 7px; background: currentColor; border-radius: 50%; }
  .jr-stat strong { font-size: 34px; line-height: 1.2; font-weight: 500; display: block; margin: 8px 0 4px; letter-spacing: -.04em; }
  .jr-stat small { color: #91a1b6; font-size: 12px; }
  .jr-task-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
  .jr-task-heading h3 { margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -.02em; }
  .demo .jr-all { border: 1px solid #3b485a; background: transparent; color: #bdd0e7; border-radius: 999px; padding: 8px 14px; min-height: 44px; cursor: pointer; font-size: 12px; }
  .jr-all[aria-pressed="true"] { background: #263347; border-color: #71839b; }
  .jr-task-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .jr-task-item { display: grid; grid-template-columns: 32px minmax(0,1fr) auto; gap: 14px; align-items: start; padding: 20px; background: #131b25; border: 1px solid #273443; border-radius: 15px; }
  .jr-task-index { font: 11px var(--d-mono); color: #70859d; padding-top: 4px; }
  .jr-task-copy p { margin: 0; font-size: 15px; line-height: 1.6; color: #dce5f1; overflow-wrap: anywhere; }
  .jr-task-copy small { display: block; color: #8094ac; font-size: 11px; margin-top: 9px; }
  .jr-category { color: var(--jr-color); border: 1px solid color-mix(in srgb,var(--jr-color) 25%,transparent); background: color-mix(in srgb,var(--jr-color) 7%,transparent); padding: 5px 10px; border-radius: 6px; font-size: 11px; white-space: nowrap; }
  .jr-result-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .jr-result-actions .btn-d { border-radius: 10px; min-height: 48px; }
  .jr-footnote { color: #8293a9; font-size: 12px; line-height: 1.6; margin: 0; }
  .jr-empty { border: 1px dashed #39495d; border-radius: 14px; padding: 24px; color: #96aac2; text-align: center; }
  .demo[data-tool="jobs"]:has(.jr-steps [data-job-step="results"][aria-current]) .jr-intro { display: none; }
  @media (max-width: 640px) {
    .demo[data-tool="jobs"] { padding: 0 16px 24px; }
    .demo[data-tool="jobs"] .tool-workspace { padding-top: 12px; }
    .demo[data-tool="jobs"] .sheet-body { padding-top: 22px; }
    .jr-intro { margin-bottom: 24px; }
    .jr-intro > p { font-size: 14px; }
    .jr-steps { gap: 8px; margin-bottom: 20px; }
    .jr-steps li { flex-direction: column; align-items: flex-start; gap: 5px; font-size: 12px; }
    .jr-card-heading { gap: 10px; margin-bottom: 22px; }
    .jr-card-heading h3 { font-size: 20px; }
    .jr-symbol { width: 36px; height: 36px; font-size: 20px; }
    .jr-input-card { border-radius: 20px; padding: 20px 16px; }
    .jr-input-meta { font-size: 10px; }
    .jr-privacy { align-items: flex-start; justify-content: flex-start; }
    .jr-summary { grid-template-columns: 1fr; gap: 12px; padding: 24px 20px; text-align: center; }
    .jr-ring { width: 210px; margin: 0 auto; }
    .jr-run-meta { justify-content: center; }
    .jr-stats { gap: 8px; }
    .demo .jr-stat { padding: 13px 10px; min-height: 112px; }
    .jr-stat-label { gap: 5px; font-size: 12px; }
    .jr-stat strong { font-size: 27px; }
    .jr-stat small { font-size: 10px; }
    .jr-task-item { grid-template-columns: 24px minmax(0,1fr); gap: 8px; padding: 16px; }
    .jr-category { grid-column: 2; justify-self: start; }
    .jr-task-copy p { font-size: 14px; }
    .jr-result-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .jr-result-actions .btn-d { padding: 10px; font-size: 13px; }
  }


  .marks { flex-wrap: wrap; gap: 12px; }
  .d-title { margin: 0 0 0 auto; font-size: clamp(20px, 3vw, 30px); }
  .usage-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:24px; }
  .usage-grid > div { border:1px solid var(--d-border); border-radius:14px; padding:16px; }
  .usage-label { font-size:12px; text-transform:uppercase; letter-spacing:.09em; color:var(--d-muted); }
  .usage-grid .d-stat { margin:8px 0; line-height:1.7; color:var(--d-text); }
  .usage-grid small { color:var(--d-muted); font-size:11px; }
  .engine-tag { font-size:11px; color:var(--d-accent); white-space:nowrap; }
  .engine-usage { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:4px 12px; font-size:11px; color:var(--d-accent); margin-top:5px; }
  #runReceipt { margin-left:auto; min-width:0; }
