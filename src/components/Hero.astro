---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import headshot from '../assets/headshot.png';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <canvas class="field" id="field" aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 class="hero-name reveal">{site.name}</h1>
      <p class="hero-headline reveal">{site.headline}</p>
      <div class="hero-actions reveal">
        <a class="btn btn-primary" href="/projects">
          See my work <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn-ghost" href={site.cta.href}>{site.cta.label}</a>
      </div>
      <nav class="socials reveal" aria-label="Elsewhere">
        {
          site.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} size={18} />
            </a>
          ))
        }
      </nav>
    </div>

    <div class="portrait reveal">
      <span class="ring" aria-hidden="true"></span>
      <span class="frame">
        <Image
          src={headshot}
          alt={`Portrait of ${site.name}`}
          width={320}
          height={320}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </span>
      <span class="status mono"><span class="live" aria-hidden="true"></span>Taking on CTO work</span>
    </div>
  </div>

  <span class="engine mono" id="engine" aria-hidden="true"></span>
</section>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement | null;
  const badge = document.getElementById('engine');
  const boot = async () => {
    if (!canvas) return;
    try {
      const { startField } = await import('../scripts/field');
      const field = await startField(canvas);
      field.canvas.classList.add('on');
      const backend = field.backend;
      if (badge) badge.textContent = `rendered with ${backend}`;
    } catch (e) {
      console.warn('field disabled:', e);
    }
  };
  // Let the page paint first; the field is decoration.
  if ('requestIdleCallback' in window) requestIdleCallback(() => boot(), { timeout: 1200 });
  else setTimeout(boot, 300);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: center;
    padding-block: clamp(56px, 9vw, 120px);
    isolation: isolate;
  }
  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .field.on {
    opacity: 1;
  }
  /* Keeps the copy legible over the field; also the no-JS/no-GPU look. */
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 55% at 22% 45%, rgba(15, 17, 21, 0.85), transparent 70%),
      radial-gradient(ellipse 90% 60% at 50% 110%, rgba(91, 141, 239, 0.14), transparent 70%),
      linear-gradient(to bottom, transparent 70%, var(--ag-bg));
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }
  .hero-name {
    font-size: clamp(42px, 7.4vw, 76px);
    font-weight: var(--ag-fw-semi);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ag-text-bright);
    margin-top: 0;
  }
  .hero-headline {
    margin-top: 14px;
    font-size: clamp(20px, 2.8vw, 28px);
    font-weight: var(--ag-fw-medium);
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, #9fc0ff, var(--ag-accent) 60%, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .socials {
    display: flex;
    gap: 6px;
    margin-top: 22px;
    margin-left: -8px;
  }
  .socials a {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--ag-radius-sm);
    color: var(--ag-muted);
    transition: color var(--ag-dur-base) var(--ag-ease), background var(--ag-dur-base) var(--ag-ease);
  }
  .socials a:hover {
    color: var(--ag-text-bright);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Portrait with a slowly turning signal ring */
  .portrait {
    position: relative;
    justify-self: center;
    width: clamp(220px, 30vw, 340px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(from var(--a, 0deg), transparent 0 55%, rgba(91, 141, 239, 0.9) 75%, #c7f0ff 80%, transparent 86%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    animation: spin 6s linear infinite;
    filter: drop-shadow(0 0 10px rgba(91, 141, 239, 0.6));
  }
  .ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--ag-border-2);
  }
  @property --a {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes spin {
    to {
      --a: 360deg;
    }
  }
  .frame {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--ag-panel);
    box-shadow: 0 30px 80px -30px rgba(91, 141, 239, 0.55);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .status {
    position: absolute;
    bottom: 4%;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: var(--ag-fs-mini);
    color: var(--ag-text-2);
    background: rgba(10, 12, 16, 0.85);
    border: 1px solid var(--ag-border-2);
    border-radius: var(--ag-radius-pill);
    padding: 6px 12px;
    backdrop-filter: blur(6px);
  }
  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ag-green-bright);
    box-shadow: var(--ag-glow-green);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .engine {
    position: absolute;
    right: 16px;
    bottom: 12px;
    font-size: var(--ag-fs-micro);
    color: var(--ag-muted);
    opacity: 0.6;
    letter-spacing: 0.04em;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .portrait {
      order: -1;
      justify-self: start;
      width: 168px;
    }
    .veil {
      background:
        linear-gradient(to bottom, rgba(15, 17, 21, 0.2), rgba(15, 17, 21, 0.75) 45%, var(--ag-bg)),
        radial-gradient(ellipse 90% 60% at 50% 0%, rgba(91, 141, 239, 0.14), transparent 70%);
    }
  }
  @media (max-width: 480px) {
    .hero-actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring,
    .live {
      animation: none;
    }
  }
</style>
