---
import type { Project } from '../data/projects';
import { categories } from '../data/projects';
import Icon from './Icon.astro';
import ProjectLogo from './ProjectLogo.astro';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<a
  class:list={['pcard spot', { branded: !!p.brand }]}
  href={`/projects/${p.slug}`}
  data-cat={p.category}
  style={p.brand ? `--brand:${p.brand.color}` : undefined}
>
  <div class="pc-media" aria-hidden="true">
    {
      p.brand?.shot ? (
        <img src={p.brand.shot} alt="" width="1280" height="800" loading="lazy" decoding="async" />
      ) : (
        <span class="pc-plate">
          <ProjectLogo project={p} size={56} />
        </span>
      )
    }
  </div>
  <div class="pc-top">
    <span class="pc-id">
      <ProjectLogo project={p} size={34} />
      <span class="pc-cat mono">{categories[p.category].short}</span>
    </span>
    <span class:list={['pc-status mono', p.status.toLowerCase().replace(' ', '-')]}>{p.status}</span>
  </div>
  <h3 class="pc-name">{p.name}</h3>
  <p class="pc-tag">{p.tagline}</p>
  <div class="pc-foot">
    <span class="pc-role">{p.role}</span>
    <span class="pc-go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
  </div>
</a>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 196px;
    padding: 20px;
    background: var(--ag-panel);
    border: 1px solid var(--ag-border);
    border-radius: var(--ag-radius-md);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color var(--ag-dur-base) var(--ag-ease),
      transform var(--ag-dur-base) var(--ag-ease);
  }
  .pcard:hover {
    text-decoration: none;
    border-color: var(--ag-accent-50);
    transform: translateY(-2px);
  }
  /* Brand edge: a thin line of the product's own colour along the top */
  .pcard.branded::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brand), transparent);
    opacity: 0.7;
    transition: opacity var(--ag-dur-base) var(--ag-ease);
  }
  .pcard.branded:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, transparent);
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--brand) 60%, transparent);
  }
  .pcard.branded:hover::after {
    opacity: 1;
  }
  .pcard.branded::before {
    background: radial-gradient(
      360px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--brand) 14%, transparent),
      transparent 60%
    );
  }
  /* Preview strip: live-site screenshot, or a brand plate with the logo */
  .pc-media {
    --brand: var(--ag-accent);
    position: relative;
    margin: -20px -20px 6px;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-bottom: 1px solid var(--ag-border);
    background: var(--ag-well);
  }
  .pcard.branded .pc-media {
    --brand: inherit;
  }
  .pc-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transform-origin: top;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pcard:hover .pc-media img {
    transform: scale(1.04);
  }
  .pc-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, color-mix(in srgb, var(--ag-panel) 85%, transparent));
    pointer-events: none;
  }
  .pc-plate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse 60% 90% at 50% 100%, color-mix(in srgb, var(--brand) 26%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--brand) 10%, transparent) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(90deg, color-mix(in srgb, var(--brand) 10%, transparent) 1px, transparent 1px) 0 0 / 22px 22px,
      var(--ag-well);
  }
  .pc-plate :global(.plogo) {
    box-shadow: 0 10px 40px -10px color-mix(in srgb, var(--brand) 70%, transparent);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pcard:hover .pc-plate :global(.plogo) {
    transform: translateY(-3px) scale(1.05);
  }
  .pc-id {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pc-cat {
    font-size: var(--ag-fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ag-accent);
  }
  .pc-status {
    font-size: var(--ag-fs-micro);
    color: var(--ag-muted);
    border: 1px solid var(--ag-border-2);
    border-radius: var(--ag-radius-pill);
    padding: 2px 8px;
  }
  .pc-status.live {
    color: var(--ag-green);
    border-color: rgba(74, 222, 128, 0.35);
  }
  .pc-status.testnet,
  .pc-status.in-development {
    color: var(--ag-amber);
    border-color: rgba(251, 191, 36, 0.3);
  }
  .pc-name {
    font-size: 19px;
    font-weight: var(--ag-fw-semi);
    color: var(--ag-text-bright);
    letter-spacing: -0.01em;
    margin-top: 4px;
  }
  .pc-tag {
    color: var(--ag-muted);
    font-size: var(--ag-fs-body);
    line-height: 1.5;
  }
  .pc-foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
  }
  .pc-role {
    font-size: var(--ag-fs-small);
    color: var(--ag-text-3);
  }
  .pc-go {
    color: var(--ag-muted);
    transition: transform var(--ag-dur-base) var(--ag-ease), color var(--ag-dur-base) var(--ag-ease);
  }
  .pcard:hover .pc-go {
    color: var(--ag-accent);
    transform: translateX(3px);
  }
</style>
